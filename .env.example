# SoulAuth configuration example
#
# Copy to .env and edit. **Only four are required** — the process will not start
# without them: JWT_SECRET / APP_URL / SMTP_HOST / SMTP_FROM.
# Everything else has a default; the full reference is in DEPLOYMENT.md.

# ── Required ────────────────────────────────────────────────────────
# At least 32 characters. Generate one: openssl rand -hex 32
JWT_SECRET=

# The **public** address, not the listen address (that's BIND_ADDR).
# It decides the OIDC issuer, the prefix of links in outgoing mail, and whether
# session cookies carry Secure.
# Pointing it at a non-loopback host opens the production gates: it must then be
# https, and the OIDC signing key and the MFA key become required.
APP_URL=http://localhost:8080

SMTP_HOST=127.0.0.1
SMTP_FROM=noreply@localhost

# ── Service ─────────────────────────────────────────────────────────
BIND_ADDR=0.0.0.0:8080
# Session and access token lifetime, in seconds
JWT_EXPIRATION=86400
PASSWORD_MIN_LENGTH=12
# How long an authenticated request may reuse a cached session check, in seconds.
# 0 = go back to the database on every request
AUTH_SESSION_CACHE_TTL_SECONDS=5
# Comma separated. Empty means only APP_URL itself is allowed
CORS_ALLOWED_ORIGINS=

# ── Account lockout (brute-force protection) ────────────────────────
# Consecutive failures before locking (must be >= 1)
LOCKOUT_MAX_ATTEMPTS=5
# How long the lock lasts, in minutes (must be >= 1)
LOCKOUT_DURATION_MINUTES=15
# How long without a new failure before the counter resets
LOCKOUT_RESET_WINDOW_MINUTES=60
# Per-account and per-IP lockout are separate; turning either off weakens the protection
LOCKOUT_USER_ENABLED=true
LOCKOUT_IP_ENABLED=true
# Administrators can unlock by hand via POST /api/security/unlock
# (needs soulauth:security.write)

# ── Bootstrapping the first administrator ───────────────────────────
# Unset      → a token is generated on every start and printed to the log
#              (the default path for single-instance development)
# A value    → that token is used (for replicas or automated deployments that
#              need every instance to agree)
# Empty      → the path is closed entirely
#
# Whichever you pick, POST /api/bootstrap/admin refuses forever once an
# administrator exists — it is a one-time door at startup, not a privilege
# escalation endpoint you can call again.
SOULAUTH_BOOTSTRAP_TOKEN=

# Set this to true only if you really are behind a controlled reverse proxy.
# Otherwise any client can forge X-Forwarded-For and walk around rate limiting
# and IP lockout.
TRUST_PROXY_HEADERS=false

# ── Database ────────────────────────────────────────────────────────
# An https:// prefix selects the TLS connector. Plaintext to a non-loopback
# address logs a warning at startup — what travels over that link is the database
# password, password hashes, and session tokens.
DATABASE_URL=127.0.0.1:8000
DATABASE_USER=root
DATABASE_PASS=root
DATABASE_NAMESPACE=auth
DATABASE_NAME=main
DATABASE_CONNECTION_TIMEOUT=30

# ── Required in production (missing either refuses to start when APP_URL is
#    not loopback) ──────────────────────────────────────────────────
# The RS256 private key for ID tokens. Without it a new one is generated on every
# restart, so every ID token already issued stops verifying, and replicas never
# agree with each other.
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
OIDC_RSA_PRIVATE_KEY_PATH=
# Or inline the PEM directly (\n is turned back into a newline)
OIDC_RSA_PRIVATE_KEY_PEM=

# The encryption key for MFA TOTP secrets. Without it the key is derived from
# JWT_SECRET, which means rotating JWT_SECRET makes every stored TOTP secret
# undecryptable.
# Generate: openssl rand -base64 32
MFA_SECRET_ENCRYPTION_KEY=

# Identifies this replica's audit hash chain. Each replica writes its own chain, so two
# replicas must not share an id — the later one's audit events would be rejected by the
# unique index. The default is BIND_ADDR, which only tells apart processes on one host,
# so this is required once APP_URL is not loopback. Use the pod or host name.
SOULAUTH_INSTANCE_ID=

# The Ed25519 seed that signs audit checkpoints. Without it the hash chain is still
# written, but nothing signs the chain head — and a chain alone can be recomputed end
# to end by anyone holding database write access.
# Generate: openssl rand -base64 32
AUDIT_INTEGRITY_KEY=

# ── Mail ────────────────────────────────────────────────────────────
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# true speaks plaintext SMTP — for a local sink only
SMTP_INSECURE=false
EMAIL_VERIFICATION_ENABLED=false

# ── Frontend page addresses (derived from APP_URL when empty) ───────
LOGIN_PAGE_URL=
VERIFY_EMAIL_PAGE_URL=
# The reset token is appended as a path segment: {this}/{token}
RESET_PASSWORD_PAGE_URL=

# ── Social login (optional; each provider needs both halves) ────────
# Configure none of them and it still runs — the matching endpoints return 501
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Required once any provider is configured. Same rule as the endpoint overrides
# below: https, or plaintext http only for an exact loopback host.
OAUTH_REDIRECT_URL=
# Endpoint root overrides: self-hosted GitHub Enterprise needs this.
# Plaintext http is only accepted for loopback.
GOOGLE_OAUTH_BASE_URL=
GITHUB_OAUTH_BASE_URL=

# ── Outbound proxy (OAuth HTTP requests only; SMTP is raw TCP and ignores it) ──
PROXY_ENABLED=false
PROXY_URL=

# ── Logging ─────────────────────────────────────────────────────────
RUST_LOG=soulauth=info,tower_http=warn
